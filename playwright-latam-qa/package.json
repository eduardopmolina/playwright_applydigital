{
  "name": "playwright-latam-qa",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:bdd": "playwright test bdd-example.spec.ts --headed",
    "test:signup": "playwright test complete-signup.spec.ts --headed --timeout=60000",
    "test:signup-debug": "playwright test complete-signup.spec.ts --headed --debug --timeout=60000",
    "prepublishOnly": "playwright show-report",
    "install:all": "npm install && npx playwright install",
    "run:lighthouse": "node ./scripts/run-lighthouse.js",
    "lighthouse:accessibility": "node ./scripts/run-lighthouse.js accessibility",
    "lighthouse:performance": "node ./scripts/run-lighthouse.js performance"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.55.1",
    "lighthouse": "^12.x.x",
    "typescript": "^5.0.0"
  }
}
